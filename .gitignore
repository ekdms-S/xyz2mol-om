# development-stage code and data — deliberately NOT part of the published package.
# `dev/` has its own private git repository; `data/` holds CSD-licensed coordinates
# (mol2 · ref_xtb2) that must never be published. Do not `git add -f` either of them.
/dev/
/data/

# failure case book — `.xyz` in here is CSD-derived, same rule as `data/`. It is a working
# artifact for the team, regenerated by `dev/analysis/scratch/260907_failure_bundles.py`
# (decision 2026-09-07, [t3-double-remaining.md] §7-2).
/failures/

# test suite — not part of what is distributed. The wheel never carried it
# (`packages.find` is `where = ["src"]`), and it is not what a caller installs or reads.
# It now lives in `dev/tests/` (2026-09-15), which `/dev/` above already covers; its last
# tracked state here is commit 75f7b57. This entry keeps a re-created root suite out.
/tests/
